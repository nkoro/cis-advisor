# Local virtual environment (the 5GB bloat source) - never commit this.
cis_env/
.venv/
__pycache__/
*.py[cod]

# Secrets - .env.* covers .env.bak, .env.local, .env.save etc.
.env
.env.*
!.env.example

# Editor and backup droppings (vim swap files can contain file contents)
*.swp
*.swo
*.orig
*.bak
*~

# Generated research telemetry (data/telemetry.csv)
*.csv

# Tooling caches
.pytest_cache/

# Paper draft is kept local only - not published to the repository
paper/

# LaTeX build artefacts (the compiled .pdf is kept)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.bbl
*.blg
