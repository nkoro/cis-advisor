# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored -- never commit real credentials.
#
#   cp .env.example .env

# --- SiliconFlow (required) -------------------------------------------------
# Create a key at https://cloud.siliconflow.com/ -> API Keys
SILICONFLOW_API_KEY=sk-replace-me

# --- Optional overrides -----------------------------------------------------
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_TIMEOUT=180

# Set to 1 ONLY if your network intercepts TLS with an untrusted root CA
# (e.g. campus SSL inspection). Leaving this at 0 keeps certificate
# verification enabled.
SILICONFLOW_INSECURE_TLS=0

# --- Gradio login -----------------------------------------------------------
# If either value is empty the UI launches with NO authentication.
ADVISOR_USERNAME=
ADVISOR_PASSWORD=

# --- Gradio server ----------------------------------------------------------
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
